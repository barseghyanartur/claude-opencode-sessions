#!/bin/sh
# Launcher used by the Claude Code plugin skills.
# Runs the bundled claude_copilot_sessions package (stdlib only) with the
# first Python >= 3.10 it can find; falls back to `uv` if none is found.
# Override the interpreter with CCS_PYTHON=/path/to/python.
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

for py in "${CCS_PYTHON:-}" python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
    [ -n "$py" ] || continue
    command -v "$py" >/dev/null 2>&1 || continue
    if "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
        exec "$py" -m claude_copilot_sessions "$@"
    fi
done

if command -v uv >/dev/null 2>&1; then
    exec uv run --quiet --no-project --python ">=3.10" python -m claude_copilot_sessions "$@"
fi

echo "copilot-sessions: Python >= 3.10 is required, but none was found." >&2
echo "Install one (e.g. 'brew install python' or 'uv python install 3.12')," >&2
echo "or point CCS_PYTHON at a suitable interpreter." >&2
exit 5
